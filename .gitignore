# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & Secrets
.venv/
venv/
ENV/
env/
.env
.env.local
.env.*.local

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# SQLite database (auto-recreated at runtime)
wearable_iot.db

# Streamlit secrets (never commit real secrets!)
.streamlit/secrets.toml

# Do NOT ignore model artifacts required for Streamlit Cloud deployment
!models/*.pkl
!models/*.json
