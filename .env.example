# ==============================================================================
# HiveMQ Server Configuration
# ==============================================================================
# For HiveMQ Cloud Serverless (from your HiveMQ Console):
# 1. Copy the "MQTT URL" from your HiveMQ Console (e.g. 24d7e24e34b544e586ec5a85804a4e7f.s1.eu.hivemq.cloud)
# 2. Add the Username & Password you created in HiveMQ Cloud under "Access Management" -> "Credentials"
# ==============================================================================

MQTT_BROKER=24d7e24e34b544e586ec5a85804a4e7f.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USE_TLS=true
MQTT_USERNAME=YOUR_HIVEMQ_USERNAME
MQTT_PASSWORD=YOUR_HIVEMQ_PASSWORD

# MQTT Topic
MQTT_BASE_TOPIC=wearable/activity/iot_lab
